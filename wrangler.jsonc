{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-town",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    // Claude model used for the agent loop. Override per environment if needed.
    "MODEL": "claude-opus-5-5",
    // "demo" serves recorded Qloo responses so the app works without a key; "live" calls hackathon.api.qloo.com.
    // When QLOO_API_KEY is set the server uses live mode automatically unless QLOO_MODE=demo.
    "QLOO_MODE": "auto"
  },
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put NAME`):
  //   ANTHROPIC_API_KEY  - from console.anthropic.com
  //   QLOO_API_KEY       - from the hackathon email
}
